# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Challonge OAuth (https://connect.challonge.com)
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
CHALLONGE_REDIRECT_URI=http://localhost:3000/api/integrations/challonge/callback
CHALLONGE_TOKEN_ENCRYPTION_KEY=

# PayMongo (https://dashboard.paymongo.com)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# StarPago Philippines (relay + merchant credentials — see docs/STARPAGO_PRODUCTION.md)
# STARPAGO_APP_ID=
# STARPAGO_APP_SECRET=
# STARPAGO_API_URL=https://ph.api.starpago.com
# STARPAGO_RELAY_URL=https://starpago-relay.regmytourna.com
# STARPAGO_RELAY_SECRET=
# STARPAGO_CALLBACK_IPS=54.151.137.174
# Platform fee on entry payments (0–100). Organizer wallet receives gross minus this fee.
PLATFORM_FEE_PERCENT=5
# Minimum wallet withdrawal in centavos (default 10000 = ₱100)
MIN_WITHDRAWAL_CENTS=10000

# Umpire scoring links (signs the PIN session cookie). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UMPIRE_SESSION_SECRET=

# Resend (https://resend.com) — verify regmytourna.com domain before using info@ in production
RESEND_API_KEY=
# Optional; default is RegMyTourna <info@regmytourna.com>
# RESEND_FROM=RegMyTourna <info@regmytourna.com>

# Optional Google OAuth via Supabase Auth provider
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
