# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Challonge OAuth (https://connect.challonge.com)
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
CHALLONGE_REDIRECT_URI=http://localhost:3000/api/integrations/challonge/callback
CHALLONGE_TOKEN_ENCRYPTION_KEY=

# PayMongo (https://dashboard.paymongo.com)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Platform fee on entry payments (0–100). Organizer wallet receives gross minus this fee.
PLATFORM_FEE_PERCENT=5

# Resend (https://resend.com)
RESEND_API_KEY=

# Optional Google OAuth via Supabase Auth provider
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
